{# Set variables for both paragraph and block contexts #}
{% set ims_popup_timer = ims_popup_timer ?? content.field_ims_popup_timer[0]['#markup'] %}
{% set ims_popup_repeat = ims_popup_repeat ?? paragraph.field_ims_popup_repeat.value %}
{% set ims_popup_background = ims_popup_background ?? content.field_ims_popup_darken_bg[0]['#markup'] %}
{% set ims_popup_logo = ims_popup_logo ?? content.field_ims_popup_logo %}
{% set ims_popup_image = ims_popup_image ?? content.field_ims_popup_image %}
{% set ims_popup_title = ims_popup_title ?? content.field_ims_popup_title %}
{% set ims_popup_text = ims_popup_text ?? content.field_ims_popup_text %}
{% set ims_popup_link_url = ims_popup_link_url ?? content.field_ims_popup_link %}

<div data-popup-timer="{{ ims_popup_timer }}" id='ims_popup'
     data-popup-repeat="{{ ims_popup_repeat }}"
     class="ims_popup {% if ims_popup_background == "On" %}darken_bg {% endif %}"
     role="dialog" aria-modal="true" aria-labelledby="popup">
    <div class="ims_popup__body">
      <button id="ims_popup__close" class="{% if ims_popup_logo.0['#item'].entity.uri.value %}ims_popup_close_white{% else %}ims_popup_close_color{% endif %}" aria-label="Close popup" href="javascript:void(0);">&times;</button>
      {% if ims_popup_logo.0['#item'].entity.uri.value %}
          <div class="ims_popup__body__logo">
            {{ ims_popup_logo }}
          </div>
      {% endif %}
      <div class="ims_popup__body__content">
        {% if ims_popup_image.0['#item'].entity.uri.value %}
          <div class="ims_popup__body__content_image">
            {{ ims_popup_image }}
          </div>
        {% endif %}
        <div class="ims_popup__body__content_text">
          {% if ims_popup_title %}
            <div class="ims_popup__body__title">
              <h3>{{ ims_popup_title }}</h3>
            </div>
          {% endif %}
          {% if ims_popup_text %}
            <div class="ims_popup__body__paragraph">
              <p>
                {{ ims_popup_text }}
              </p>
            </div>
          {% endif %}
          {% if ims_popup_link_url %}
            <div class="ims_popup__body__link {% if not ims_popup_text and not ims_popup_title %}ims_popup__body__link__padding{% endif %}">
              {{ ims_popup_link_url }}
            </div>
          {% endif %}
        </div>
      </div>
    </div>
</div>